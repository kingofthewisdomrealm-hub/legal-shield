# ---------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it holds passwords.
# ---------------------------------------------------------------

# Postgres connection (Supabase: Project Settings → Database → Connection string)
# DATABASE_URL = the pooled connection (port 6543 on Supabase, add ?pgbouncer=true)
# DIRECT_URL   = the direct connection (port 5432) — used for migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legalshield"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/legalshield"

# Login for the CRM (HTTP Basic Auth). Required in production — the CRM holds contact data.
ADMIN_USER="josias"
ADMIN_PASSWORD="change-me"

# Official enrollment destination (Josias's independent associate site)
NEXT_PUBLIC_ASSOCIATE_URL="https://josias.legalshieldassociate.com/"

# Sender identity shown in the app and (later) in every email footer — CAN-SPAM requires a real postal address
NEXT_PUBLIC_SENDER_NAME="Josias"
SENDER_POSTAL_ADDRESS=""
